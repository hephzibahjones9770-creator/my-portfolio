datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Profile {
  id         String   @id @default(uuid())
  name       String
  bio        String?
  avatarUrl  String?
  resumeUrl  String?
  updatedAt  DateTime @updatedAt
}

model School {
  id           String              @id @default(uuid())
  name         String
  degree       String
  startDate    DateTime
  endDate      DateTime?
  certificates SchoolCertificate[]
}

model SchoolCertificate {
  id        String   @id @default(uuid())
  title     String
  fileUrl   String
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model College {
  id        String     @id @default(uuid())
  name      String
  degree    String
  semesters Semester[]
}

model Semester {
  id        String             @id @default(uuid())
  number    Int
  gpa       Float?
  collegeId String
  college   College            @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  documents SemesterDocument[]
}

model SemesterDocument {
  id         String   @id @default(uuid())
  name       String
  fileUrl    String
  semesterId String
  semester   Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
}

model Skill {
  id       String @id @default(uuid())
  name     String
  category String
  level    Int?
}

model Project {
  id          String   @id @default(uuid())
  title       String
  description String
  videoUrl    String?
  pptUrl      String?
  demoUrl     String?
  githubUrl   String?
  otherLinks  String[]
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}
