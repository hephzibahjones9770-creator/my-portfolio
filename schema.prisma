datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}


generator client {
  provider = "prisma-client-js"
}

model Profile {
  id         String   @id @default(uuid())
  name       String
  bio        String?
  avatarUrl  String?
  resumeUrl  String?
  published  Boolean  @default(false)
  updatedAt  DateTime @updatedAt
}

model School {
  id           String              @id @default(uuid())
  name         String
  degree       String
  startDate    DateTime
  endDate      DateTime?
  published    Boolean             @default(false)
  certificates SchoolCertificate[]
}

model SchoolCertificate {
  id        String   @id @default(uuid())
  title     String
  fileUrl   String
  published Boolean  @default(false)
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model College {
  id        String     @id @default(uuid())
  name      String
  degree    String
  published Boolean    @default(false)
  semesters Semester[]
}

model Semester {
  id        String             @id @default(uuid())
  number    Int
  gpa       Float?
  collegeId String
  college   College            @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  documents SemesterDocument[]
}

model SemesterDocument {
  id         String   @id @default(uuid())
  name       String
  fileUrl    String
  semesterId String
  semester   Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
}

model Skill {
  id       String @id @default(uuid())
  name     String
  category String
  level    Int?
  published Boolean @default(false)
}

model Project {
  id          String   @id @default(uuid())
  title       String
  description String
  imageUrl    String?
  videoUrl    String?
  pptUrl      String?
  demoUrl     String?
  githubUrl   String?
  otherLinks  String[]
  published   Boolean  @default(false)
}

model Achievement {
  id          String   @id @default(uuid())
  title       String
  description String?
  date        DateTime?
  url         String?
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Experience {
  id          String   @id @default(uuid())
  company     String
  role        String
  description String?
  startDate   DateTime
  endDate     DateTime?
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}

model AdminAccount {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MediaItem {
  id          String   @id @default(uuid())
  name        String
  type        String
  category    String
  size        Int
  url         String
  public      Boolean  @default(false)
  description String?
  usedBy      String?
  uploadedAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteSettings {
  id               String   @id @default("site")
  siteTitle        String   @default("Portfolio")
  siteDescription  String   @default("A portfolio of technology, research, and creative work.")
  socialImageUrl   String?
  themeMode        String   @default("dark")
  primaryColor     String   @default("#3d7cff")
  accentColor      String   @default("#7fe6e1")
  animations       Boolean  @default(true)
  backgroundEffects Boolean  @default(true)
  seoEnabled       Boolean  @default(true)
  updatedAt        DateTime @updatedAt
}

model AnalyticsEvent {
  id         String   @id @default(uuid())
  type       String
  path       String?
  entityId   String?
  createdAt  DateTime @default(now())

  @@index([type, createdAt])
  @@index([entityId, type])
}

model ActivityLog {
  id         String   @id @default(uuid())
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model PortfolioBackup {
  id        String   @id @default(uuid())
  filename  String
  payload   Json
  createdAt DateTime @default(now())
}

